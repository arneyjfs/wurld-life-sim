# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Capacitor / native build artifacts
ios/App/Pods
ios/App/Podfile.lock
ios/App/build
ios/App/App/public
android/.gradle
android/build
android/app/build
android/local.properties
android/captures
android/app/release
android/app/src/main/assets/public
.DS_Store

# Scratch screen recordings (kept locally only)
reference-screenshots/*.mov

# Playwright + visual-review screenshot runs — timestamped, kept local.
# Curated baselines (when adopted) should live under a separate path
# so this rule doesn't grab them.
screenshots/

# Generated at build time by scripts/generate-licenses.mjs
public/THIRD_PARTY_LICENSES.html
tests/e2e/node_modules/
tests/e2e/.env.test
tests/e2e/playwright-report/
tests/e2e/test-results/
tests/e2e/.emulator.pid
tests/e2e/firebase-debug.log
tests/e2e/firestore-debug.log
tests/e2e/wurld-firebase-service-account.json

# Prompt-eval Gemini outputs (regenerate with run-tests.py)
tests/prompts/**/results/
tests/prompts/**/__pycache__/

# Cloud Functions build output + secrets
functions/lib/
functions/.env
functions/.env.*
# Per-project param values (no secrets: LIFE_DATA_PROJECT, ALLOWED_ORIGINS_EXTRA,
# API_MIN_INSTANCES; docs/setup.md) are meant to be committed. Un-ignore yours:
# !functions/.env.<your-project-id>
!functions/.env
functions/.runtimeconfig.json
.firebase/

# Personal gcloud account binding — per-developer config, not project state
.envrc
.claude/worktrees/
# Per-machine Claude Code config (permission allow-lists etc.) — not project state
.claude/settings.local.json
.claude/*.local.json
functions/buildInfo.json
tests/prompts/.metrics/

# Measurement transcripts (scripts/measure) — large, regenerable
scripts/measure/.out/
scripts/measure/__pycache__/

# Playthrough benchmark output — transcripts, scores and the full call log.
# Regenerated by `run.play.ts`; large, and real-model output rather than source.
.playthroughs/

# Prompt-eval archive for the cost-optimisation gate (COST-EVAL-1) — raw
# Gemini responses, regenerated on demand, never reviewed as source.
.eval-runs/

# Per-scenario ledgers for the free-tier policy table (COST-POLICY-9) —
# regenerated on demand, one full week each.
scripts/cost-sim/.scenarios/
# Same, for the per-user policy trace (COST-POLICY-13).
scripts/cost-sim/.trace/

# Per-population ledgers for COST-POP-3 — regenerated on demand.
scripts/cost-sim/.society/

# Per-option ledgers for COST-TIER-9 — regenerated on demand.
scripts/cost-sim/.options/

# Per-scenario ledgers for the groups-are-premium model (COST-TIER-14) —
# regenerated on demand.
scripts/cost-sim/.groups/

# TS incremental build state — never committed (a stray one landed in 34fcb03).
*.tsbuildinfo

# Python bytecode from the measure / prompt-eval harnesses
__pycache__/

# REL-2: iOS archive / .ipa output of scripts/release/ios-testflight.mjs
/build/

# OBS-OPS-3 — generated per hosting deploy by scripts/release/hosting-config.mjs
firebase.hosting.deploy.json
