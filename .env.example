VITE_ENV=dev

VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

VITE_FUNCTIONS_URL=
VITE_FCM_VAPID_KEY=

# ── Firebase App Check ──────────────────────────────────────────────────
# OPTIONAL, and LEAVING IT EMPTY IS THE CURRENT, CORRECT STATE.
#
# The key IS the on-switch: with no site key the client initialises no App
# Check, loads no SDK, attaches no token, and the Cloud Functions reject
# nothing. There is no separate enable/disable flag to get out of sync.
#
# The value is a reCAPTCHA SITE key — public, like VITE_FIREBASE_API_KEY, so
# it belongs in the committed .env.beta / .env.production once it exists. It
# CANNOT be created from a terminal: a human has to register the web app in
# the Firebase console. Full runbook — console steps, what to watch, and what
# must be true before enforcement is switched on — in docs/specs/app-check.md
# §5. Do not set this without reading it; the emulator + E2E harnesses ignore
# it (they cannot pass reCAPTCHA), but a Capacitor build cannot attest at all.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Which reCAPTCHA flavour the key above is. Not inferable from the key string,
# and guessing wrong yields a client that cannot attest. `enterprise` (the
# default when unset) or `v3` for a legacy reCAPTCHA v3 key.
VITE_FIREBASE_APPCHECK_PROVIDER=

# ── Sentry ──────────────────────────────────────────────────────────────
# Client error reporting. The DSN is public (it ships in the client bundle),
# so it's fine in the committed .env.beta / .env.production. Empty = Sentry
# stays uninstalled (errors fall back to console).
VITE_SENTRY_DSN=

# Source-map upload (BUILD-TIME ONLY — never bundled into the client, so it
# does NOT use the VITE_ prefix). Without these, Sentry stack traces are
# minified. The AUTH TOKEN IS A SECRET — put it ONLY in .env.local (gitignored)
# or a CI secret, NEVER in the committed .env.beta / .env.production.
# Get org+project slugs + an auth token (project:releases scope) from
# Sentry → Settings. Org is in the EU region (url defaults to de.sentry.io).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# SENTRY_URL=https://de.sentry.io/   # override only if the org moves region
