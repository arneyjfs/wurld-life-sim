{
  "name": "wurld-life-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wurlds: an AI language-learning life simulator, extracted from the Wurld app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit && npm run typecheck:functions",
    "typecheck:functions": "npm --prefix functions exec -- tsc --noEmit -p functions/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm --prefix functions run build && tests/e2e/node_modules/.bin/firebase emulators:exec --only auth,firestore,functions,storage --project demo-wurlds \"cd tests/e2e && npx playwright test --config playwright.emulator.config.ts $E2E_ARGS\"",
    "test:playthrough": "vitest run --config tests/playthrough/vitest.config.ts run.play",
    "test:playthrough:rescore": "vitest run --config tests/playthrough/vitest.config.ts rescore",
    "test:playthrough:sweep": "node --experimental-strip-types tests/playthrough/anomalySweep.ts",
    "emulators": "npm --prefix functions run build && firebase emulators:start --only auth,firestore,functions,storage --project demo-wurlds",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore,storage",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy": "npm run deploy:functions && npm run deploy:hosting"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.3.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/native-purchases": "^8.9.6",
    "@fontsource/caveat": "^5.3.0",
    "@sentry/capacitor": "4.4.0",
    "@sentry/react": "10.69.0",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.14.0",
    "mediabunny": "^1.59.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.0.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.11"
  }
}
