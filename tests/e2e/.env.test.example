# ─── E2E Test Configuration ───
# Copy this to .env.test and fill in values.
#
# ISOLATION: All test-specific env vars live ONLY in this file and are ONLY
# loaded by the Playwright test runner. Normal `expo start` never sees them.

# ─── App URL ──────────────────────────────────────────────────────────────────
# Local dev server (Playwright starts it automatically via webServer config):
E2E_BASE_URL=http://localhost:8081
# Or test against deployed beta (comment out webServer in playwright.config.ts):
# E2E_BASE_URL=https://wurld-beta.web.app

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Service account key for the PRODUCTION project (wurld-e27d8).
# The Admin SDK always talks to REAL Auth + Firestore (never the emulator).
# Download from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
FIREBASE_PROJECT_ID=wurld-e27d8

# Firebase Web API Key (for custom token → ID token exchange against REAL,
# i.e. prod, Auth). HARNESS-PROD-1: used only when E2E_ALLOW_PROD=1 (set by
# the prod-config npm scripts: test:e2e, test:e2e:prod-smoke, :standard,
# :full, :headed, :ui). The emulator harness ignores it. There is no built-in
# fallback — leave it empty and a prod token exchange throws.
# Found in: Firebase Console > Project Settings > General > Web API Key
FIREBASE_API_KEY=

# ─── Auth Emulator ────────────────────────────────────────────────────────────
# The Auth Emulator handles browser-side authentication (no reCAPTCHA, any phone works).
# Admin SDK does NOT connect to the emulator — it always uses real Auth.
# Playwright's Token Bridge swaps emulator tokens → real tokens for Cloud Function calls.
USE_AUTH_EMULATOR=true
AUTH_EMULATOR_URL=http://127.0.0.1:9099
AUTH_EMULATOR_HOST=127.0.0.1
AUTH_EMULATOR_PORT=9099

# To disable the emulator (e.g. testing against deployed beta with real Auth):
# USE_AUTH_EMULATOR=false

# ─── Test Phone Numbers ──────────────────────────────────────────────────────
# With Auth Emulator: any phone number + any verification code works.
# Without emulator: must be registered in Firebase Console as test numbers.
TEST_PHONE_A=+10000000001
TEST_PHONE_B=+10000000002
TEST_VERIFICATION_CODE=123456

# ─── Cloud Functions ─────────────────────────────────────────────────────────
# Always points to REAL Cloud Functions (wurld-beta).
# The Token Bridge ensures these receive valid auth tokens.
FUNCTIONS_URL=https://us-central1-wurld-beta.cloudfunctions.net
